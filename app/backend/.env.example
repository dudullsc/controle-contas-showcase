# Example environment variables
# Copy this file to .env and fill in your values

# MongoDB Configuration
MONGODB_URL=mongodb://username:password@host:port
DATABASE_NAME=controle_contas

# JWT Configuration
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Cookie HttpOnly (JWT). Dev HTTP local: AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# Email Configuration (Gmail SMTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM_NAME=Controle de Contas
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_TLS=true

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Notificações (WhatsApp WAHA + FCM push no app)
ENABLE_NOTIFICATIONS=true
WAHA_BASE_URL=https://botzap.example.com
WAHA_API_KEY=
WAHA_SESSION=default
NOTIFICATION_CHECK_TIME=09:00

# Firebase Cloud Messaging (push com app fechado)
# 1) Firebase → Contas de serviço → Gerar nova chave privada
# 2) Salve em: app/backend/secrets/firebase-service-account.json (gitignored)
FCM_CREDENTIALS_FILE=secrets/firebase-service-account.json
# Em produção (k8s), preferir JSON inline no Secret:
# FCM_CREDENTIALS_JSON={"type":"service_account",...}

# Backup MongoDB → Google Drive (OAuth)
# 1) Google Cloud Console → APIs → ativar Google Drive API
# 2) Credenciais → OAuth client ID (Web application)
# 3) Redirect URI (dev): http://localhost:3000/dashboard/settings
#    Produção: https://contas.example.com/dashboard/settings
ENABLE_BACKUPS=true
BACKUP_CRON_TIME=03:00
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/dashboard/settings
GOOGLE_DRIVE_BACKUP_FOLDER=ControleContas/Backups

# MinIO / S3 (comprovantes). Dev local usa o endpoint público.
# Produção (in-cluster): http://minio.minio.svc.cluster.local:9000 e S3_USE_SSL=false
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=controle-contas-receipts
S3_USE_SSL=true
S3_REGION=us-east-1
S3_MAX_RECEIPT_BYTES=5242880

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
