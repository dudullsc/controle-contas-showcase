{
  "name": "controle-contas-mobile",
  "version": "1.0.22",
  "private": true,
  "description": "Shell Capacitor do Controle de Contas (Android/iOS)",
  "scripts": {
    "sync": "npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "build:apk": "cd android && .\\gradlew.bat assembleDebug",
    "build:apk:release": "cd android && .\\gradlew.bat assembleRelease",
    "release:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-apk.ps1",
    "release:apk:skip-bump": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-apk.ps1 -SkipBump"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.3",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.6",
    "@capgo/capacitor-native-biometric": "^7.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "typescript": "^5.9.2"
  }
}
